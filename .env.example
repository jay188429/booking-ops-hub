# Supabase 대시보드 -> Project Settings -> API 에서 복사
# 이 파일을 .env 로 이름 바꾸고 아래 값을 실제 값으로 교체한다

VITE_SUPABASE_URL=여기에_Project_URL_붙여넣기
VITE_SUPABASE_ANON_KEY=여기에_anon_public_key_붙여넣기

# 관리자 이메일 (Google OAuth로 로그인한 사용자의 이메일)
VITE_ADMIN_EMAIL=admin@example.com

# Geoapify Geocoding API 키 (주소 -> 좌표 변환)
# https://www.geoapify.com 에서 API 키 발급
VITE_GEOAPIFY_API_KEY=여기에_Geoapify_API_Key_붙여넣기

# Slack Webhook URL (새 예약 알림)
# Slack Workspace -> Apps -> Incoming Webhooks 에서 생성
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
